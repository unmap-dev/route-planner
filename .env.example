# Your Unmap browser key, from https://unmap.dev/dashboard (free).
# It ships in the browser bundle: restrict it to your origins (e.g. http://localhost:3202 and your
# production domain) in the dashboard.
NEXT_PUBLIC_UNMAP_KEY=

# Optional. Defaults to https://api.unmap.dev.
# NEXT_PUBLIC_UNMAP_GATEWAY=https://api.unmap.dev

# Optional. The path the app is served under, e.g. /routes. Empty for a site of its own.
# BASE_PATH=
